# Copy this file to .env and fill in your values
# Then load it with: source .env  OR  use python-dotenv in your code

# ── Required ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Milvus (local standalone default) ────────────────────────────────────
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=                          # leave blank for local Milvus
MILVUS_COLLECTION=incident_monthly_summaries

# ── For Zilliz Cloud (managed Milvus) ────────────────────────────────────
# MILVUS_URI=https://<your-cluster>.zillizcloud.com
# MILVUS_TOKEN=<your-api-key>
