						"in": "header",
						"required": false,
						"schema": {
							"anyOf": [
								{
									"type": "string"
								},
								{
									"type": "null"
								}
							],
							"title": "X-Message-Id"
						}
					},
					{
						"name": "X-User-ID",
						"in": "header",
						"required": false,
						"schema": {
							"anyOf": [
								{
									"type": "string"
								},
								{
									"type": "null"
								}
							],
							"title": "X-User-Id"
						}
					},
					{
						"name": "X-Tenant-Id",
						"in": "header",
						"required": false,
						"schema": {
							"anyOf": [
								{
									"type": "string"
								},
								{
									"type": "null"
								}
							],
							"title": "X-Tenant-Id"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/InvokeRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Successful Response"
					},
					"422": {
						"description": "Validation Error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HTTPValidationError"
								}
							}
						}
					}
				}
			}
		},
		"/a2a/work-item/{external_ref}": {
			"get": {
				"tags": [
					"work_item"
				],
				"summary": "Work Item Status",
				"description": "Return the cached run-status snapshot for a work item.\n\nLooked up via ``(pack_id, external_ref)`` against the active pack\nso a polling caller sees the same answer the next POST would\nreturn.  ``status`` is derived from the row's ``status`` column +\na freshness check on ``run_deadline_at``: a row that's still\n``running`` past its deadline is surfaced as ``stale`` so callers\ncan act on worker death without a heartbeat channel.\n\nReturns ``404`` when no work_item row exists for the active pack\nand external_ref.",
				"operationId": "work_item_status_a2a_work_item__external_ref__get",
				"parameters": [
					{
						"name": "external_ref",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string",
							"title": "External Ref"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Successful Response",
						"content": {
							"application/json": {
								"schema": {}
							}
						}
					},
					"422": {
						"description": "Validation Error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HTTPValidationError"
								}
							}
						}
					}
				}
			}
		},
