	"components": {
		"schemas": {
			"HTTPValidationError": {
				"properties": {
					"detail": {
						"items": {
							"$ref": "#/components/schemas/ValidationError"
						},
						"type": "array",
						"title": "Detail"
					}
				},
				"type": "object",
				"title": "HTTPValidationError"
			},
			"HealthResponse": {
				"properties": {
					"status": {
						"type": "string",
						"pattern": "^(healthy|unhealthy|degraded)$",
						"title": "Status",
						"description": "Overall health status",
						"example": "healthy"
					},
					"timestamp": {
						"type": "string",
						"title": "Timestamp",
						"description": "Health check timestamp in ISO format",
						"example": "2025-09-16T10:30:45.123Z"
					},
					"rag_ready": {
						"type": "boolean",
						"title": "Rag Ready",
						"description": "Whether RAG system is initialized and ready"
					},
					"postgres_ready": {
						"type": "boolean",
						"title": "Postgres Ready",
						"description": "Whether PostgreSQL database is available"
					},
					"redis_ready": {
						"type": "boolean",
						"title": "Redis Ready",
						"description": "Whether Redis cache is available"
					},
					"version": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						],
						"title": "Version",
						"description": "Service version",
						"default": "1.0.0"
					},
					"dependencies": {
						"anyOf": [
							{
								"additionalProperties": true,
								"type": "object"
							},
							{
								"type": "null"
							}
						],
						"title": "Dependencies",
						"description": "Detailed dependency status information"
					}
				},
				"type": "object",
				"required": [
					"status",
					"timestamp",
					"rag_ready",
					"postgres_ready",
					"redis_ready"
				],
				"title": "HealthResponse",
				"description": "Response model for health check endpoint.\n\nPurpose:\n- Provides overall service health status\n- Includes dependency health information\n- Used by /healthz endpoint\n- Enables monitoring and alerting systems\n\nFields:\n- status: Overall health status\n- timestamp: When the health check was performed\n- rag_ready: Whether RAG system is initialized\n- postgres_ready: Whether PostgreSQL is available\n- redis_ready: Whether Redis is available\n- version: Service version information",
				"example": {
					"dependencies": {
						"lightrag": {
							"last_check": "2025-09-16T10:30:40Z",
							"status": "healthy"
						},
						"postgres": {
							"connections": 5,
							"status": "healthy"
						},
						"redis": {
							"memory_usage": "45%",
							"status": "healthy"
						}
					},
					"postgres_ready": true,
					"rag_ready": true,
					"redis_ready": true,
					"status": "healthy",
					"timestamp": "2025-09-16T10:30:45.123Z",
					"version": "1.0.0"
				}
			},
			"InvokeRequest": {
				"properties": {
					"input": {
						"title": "Input",
						"description": "Inbound payload — any JSON-shaped value (str, dict, list, scalar).  Dict-shaped input is treated as the upstream domain_payload verbatim; non-dict input is flattened into work_item_text."
					},
					"session_id": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						],
						"title": "Session Id",
						"description": "Conversation/thread identifier.  Falls back to the X-Session-ID header, then to a generated id."
					},
					"agent_id": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						],
						"title": "Agent Id",
						"description": "Target pack id.  When unset, the active pack from the registry is used."
					},
					"kind": {
						"anyOf": [
							{
								"type": "string",
								"enum": [
									"work_item",
									"approval_callback",
									"chat"
								]
							},
							{
								"type": "null"
							}
						],
						"title": "Kind",
						"description": "Hint for routing inside the framework.  When unset, the dispatcher infers the kind from the input shape."
					},
					"metadata": {
						"anyOf": [
							{
								"additionalProperties": true,
								"type": "object"
							},
							{
								"type": "null"
							}
						],
						"title": "Metadata",
						"description": "Free-form context (trace ids, calling-agent tags, etc.).  Stored on the work_item / session domain_data."
					}
				},
				"type": "object",
				"required": [
					"input"
				],
				"title": "InvokeRequest",
				"description": "Accept-any-input request — `input` may be a str, dict, list, or scalar.  The default example is a `kind=\"chat\"` invocation with a free-form query string.  For `kind=\"work_item\"` send the upstream record as a dict (e.g. `{\"external_ref\": \"INC52148837\", ...}`); for `kind=\"approval_callback\"` send `{\"external_ref\": \"...\", \"approved\": true, ...}`.  When `kind` is omitted the dispatcher infers it from the input shape.",
				"example": {
					"input": "What are the steps to triage a checkout latency spike?",
					"kind": "chat",
					"session_id": "sess_abc123"
				}
			},
			"ReadinessResponse": {
				"properties": {
					"status": {
						"type": "string",
						"pattern": "^(ready|not_ready)$",
						"title": "Status",
						"description": "Readiness status",
						"example": "ready"
					},
					"timestamp": {
						"type": "string",
						"title": "Timestamp",
						"description": "Readiness check timestamp in ISO format",
						"example": "2025-09-16T10:30:45.123Z"
					},
					"ready": {
						"type": "boolean",
						"title": "Ready",
						"description": "Boolean indicating if service is ready to accept traffic"
					},
					"blocking_dependencies": {
						"anyOf": [
							{
								"items": {},
								"type": "array"
							},
							{
								"type": "null"
							}
						],
						"title": "Blocking Dependencies",
						"description": "List of dependencies preventing readiness"
					},
					"details": {
						"anyOf": [
							{
								"additionalProperties": true,
								"type": "object"
							},
							{
								"type": "null"
							}
						],
						"title": "Details",
						"description": "Additional readiness check details"
					}
				},
				"type": "object",
				"required": [
					"status",
					"timestamp",
					"ready"
				],
				"title": "ReadinessResponse",
				"description": "Response model for readiness check endpoint.\n\nPurpose:\n- Indicates if service is ready to accept traffic\n- Used by Kubernetes readiness probes\n- More strict than health checks\n- Used by /readyz endpoint\n\nFields:\n- status: Readiness status\n- timestamp: When the readiness check was performed\n- ready: Boolean indicating if service is ready\n- blocking_dependencies: List of dependencies preventing readiness",
				"example": {
					"blocking_dependencies": [],
					"details": {
						"database_connection_pool": "healthy",
						"rag_initialization_time": 12.5
					},
					"ready": true,
					"status": "ready",
					"timestamp": "2025-09-16T10:30:45.123Z"
				}
