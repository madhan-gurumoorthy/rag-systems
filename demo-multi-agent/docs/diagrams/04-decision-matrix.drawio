        <!-- Note box -->
        <mxCell id="60" value="&lt;b&gt;Decision Engine Properties&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;• 100% deterministic (no LLM judgment)&lt;br&gt;• Rules evaluated IN ORDER — first match wins&lt;br&gt;• 5 rules + 1 fallback = 6 runbook cards&lt;br&gt;• RULE-2 uses requires_absent for first-encounter OVERSIZED&lt;br&gt;• RAG fallback only when confidence = low&lt;br&gt;• Tool: DIAG-DECISION-MATRIX (python_function)&lt;br&gt;• data_not_found is NOT an error (optional data source)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="260" height="105" as="geometry"/>
        </mxCell>

        <!-- Rule table -->
        <mxCell id="70" value="&lt;b&gt;Rule Evaluation Order&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;RULE-1: FITS_TOTE → RBK-GIF-01&lt;br&gt;RULE-2: OVERSIZED + no merchant_response → MERCHANT_OUTREACH&lt;br&gt;RULE-3: OVERSIZED + CORRECT → RBK-GIF-02&lt;br&gt;RULE-4: OVERSIZED + UPDATE + GOLD → RBK-GIF-03&lt;br&gt;RULE-5: OVERSIZED + UPDATE + NOT_GOLD → RBK-GIF-04&lt;br&gt;FALLBACK: else → RBK-GIF-05&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
