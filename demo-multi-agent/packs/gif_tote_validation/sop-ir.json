  "diagnostics": [
    {
      "id": "DIAG-TICKET-01",
      "depends_on": [],
      "purpose": "Detect GIF tote-related incidents and extract structured form data",
      "inputs": [
        "incident_number",
        "original_short_description",
        "description_body",
        "upc_win",
        "store_number",
        "assignment_group",
        "ticket_state",
        "work_notes",
        "comments"
      ],
      "outputs": {
        "observation_codes": [
          "INCIDENT_MATCHED",
          "INCIDENT_NOT_MATCHED",
          "PARSE_FAILURE"
        ]
      }
    },
    {
      "id": "DIAG-UBERKEYS-01",
      "depends_on": [
        "DIAG-TICKET-01"
      ],
      "purpose": "Resolve GTIN from UPC or Walmart item number (WIN) via Uber Keys (UPC_TO_GTIN, SI_TO_GTIN)",
      "inputs": [
        "incident_number",
        "original_short_description",
        "description_body",
        "upc_win",
        "store_number",
        "assignment_group",
        "ticket_state",
        "work_notes",
        "comments"
      ],
      "outputs": {
        "observation_codes": [
          "GTIN_FOUND",
          "GTIN_NOT_FOUND"
        ]
      }
    },
    {
      "id": "DIAG-API-01",
      "depends_on": [
        "DIAG-UBERKEYS-01"
      ],
      "purpose": "Retrieve item dimensions from GIF API",
      "inputs": [
        "incident_number",
        "original_short_description",
        "description_body",
        "upc_win",
        "store_number",
        "assignment_group",
        "ticket_state",
        "work_notes",
        "comments"
      ],
      "outputs": {
        "observation_codes": [
          "DATA_FOUND",
          "DATA_NOT_FOUND",
          "API_ERROR"
        ]
      }
    },
    {
      "id": "DIAG-API-02",
      "depends_on": [
        "DIAG-API-01"
      ],
      "purpose": "Determine Gold status and product info from IQS API",
      "inputs": [
        "incident_number",
        "original_short_description",
        "description_body",
        "upc_win",
        "store_number",
        "assignment_group",
        "ticket_state",
        "work_notes",
        "comments"
      ],
      "outputs": {
        "observation_codes": [
          "GOLD",
          "NOT_GOLD",
          "API_ERROR"
        ]
      }
    },
    {
      "id": "DIAG-API-03",
      "depends_on": [
        "DIAG-API-02"
      ],
      "purpose": "Retrieve supplier dimensions from Uber API (if not Gold)",
      "inputs": [
        "incident_number",
        "original_short_description",
        "description_body",
        "upc_win",
        "store_number",
        "assignment_group",
        "ticket_state",
        "work_notes",
        "comments"
      ],
      "outputs": {
        "observation_codes": [
          "DATA_FOUND",
          "DATA_NOT_FOUND",
          "API_ERROR"
        ]
      }
    },
    {
      "id": "DIAG-LOGIC-01",
      "depends_on": [],
      "purpose": "Validate item dimensions against tote constraints",
      "inputs": [
        "incident_number",
        "original_short_description",
        "description_body",
        "upc_win",
        "store_number",
        "assignment_group",
        "ticket_state",
        "work_notes",
        "comments"
      ],
      "outputs": {
        "observation_codes": [
          "FITS_TOTE",
          "OVERSIZED"
        ]
      }
    }
  ],
  "decision_flowchart": "\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n                    \u2502   START: Incident    \u2502\n                    \u2502   Detected in SNOW   \u2502\n                    \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n                               \u2502\n                    \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u25bc\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n                    \u2502  DIAG-TICKET-01:      \u2502\n                    \u2502  Parse Incident     \u2502\n                    \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n                          \u250c\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2510\n                     MATCH \u2502         \u2502 NO MATCH\n                          \u25bc         \u25bc\n                    \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510  \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n                    \u2502DIAG-UBERKEYS-01\u2502  \u2502 RBK-GIF-05 \u2502\n                    \u2502 UPC/SI to GTIN \u2502  \u2502 Escalate   \u2502\n                    \u2514\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2518  \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n                         \u2502\n                    \u250c\u2500\u2500\u2500\u2500\u25bc\u2500\u2500\u2500\u2500\u2500\u2510\n                    \u2502 DIAG-API-01\u2502\n                    \u2502 GIF API   \u2502\n                    \u2514\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2518\n                         \u2502\n                    \u250c\u2500\u2500\u2500\u2500\u25bc\u2500\u2500\u2500\u2500\u2500\u2510\n                    \u2502 DIAG-API-02\u2502\n                    \u2502 IQS API   \u2502\n                    \u2514\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2518\n                         \u2502\n                    \u250c\u2500\u2500\u2500\u2500\u25bc\u2500\u2500\u2500\u2500\u2500\u2510\n                    \u2502 DIAG-API-03\u2502\n                    \u2502 Uber API  \u2502\n                    \u2514\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2518\n                         \u2502\n                    \u250c\u2500\u2500\u2500\u2500\u25bc\u2500\u2500\u2500\u2500\u2500\u2510\n                    \u2502 DIAG-LOGIC-01\u2502\n                    \u2502 Tote Fit  \u2502\n                    \u2514\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2518\n                         \u2502\n          \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n          \u2502                              \u2502\n   FITS_TOTE                      OVERSIZED\n          \u2502                              \u2502\n    \u250c\u2500\u2500\u2500\u2500\u2500\u25bc\u2500\u2500\u2500\u2500\u2500\u2510               \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u25bc\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n    \u2502 RBK-GIF-01\u2502               \u2502 Merchant Outreach\u2502\n    \u2502 Auto-Route\u2502               \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n    \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518                        \u2502\n \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u25bc\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n                                \u2502 Merchant Reply \u2502\n                                \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n                        \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n                        \u2502                              \u2502\n          Confirmed Correct Dimensions      Confirmed Update Needed\n                        \u2502                              \u2502\n                \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510             \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u25bc\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n                \u2502 RBK-GIF-02    \u2502             \u2502 IsGold?          \u2502\n                \u2502 Route to GIF  \u2502             \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n                \u2502 Picking Team  \u2502                     \u2502\n                \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518             \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u25bc\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n                                            \u2502 TRUE          \u2502\n                                            \u2502 RBK-GIF-03    \u2502\n                                            \u2502 SSOT Update   \u2502\n                                            \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n                                            \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n                                            \u2502 FALSE         \u2502\n                                            \u2502 RBK-GIF-04    \u2502\n                                            \u2502 iSAM Update   \u2502\n                                            \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518",
  "decision_rules": [
    {
      "when": {
        "all": [
          "DIAG-LOGIC-01 = FITS_TOTE"
        ],
        "any": [],
        "expressions": []
      },
      "then_runbook": "RBK-GIF-01"
    },
    {
      "when": {
        "all": [
          "DIAG-LOGIC-01 = OVERSIZED",
          "Merchant confirms dimensions correct"
        ],
        "any": [],
        "expressions": []
      },
      "then_runbook": "RBK-GIF-02"
    },
    {
      "when": {
        "all": [
          "DIAG-LOGIC-01 = OVERSIZED",
          "Merchant confirms dimensions need update",
          "isGold = TRUE"
        ],
        "any": [],
        "expressions": []
      },
      "then_runbook": "RBK-GIF-03"
    },
    {
      "when": {
        "all": [
          "DIAG-LOGIC-01 = OVERSIZED",
          "Merchant confirms dimensions need update",
          "isGold = FALSE"
        ],
        "any": [],
        "expressions": []
      },
      "then_runbook": "RBK-GIF-04"
    },
    {
      "when": {
        "all": [
          "ELSE / API_ERROR / PARSE_FAILURE / Missing data"
        ],
        "any": [],
        "expressions": []
      },
      "then_runbook": "RBK-GIF-05"
    }
  ],
