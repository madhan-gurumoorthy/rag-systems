{
  "metadata": {
    "title": "1P Store Path Eligibility Validation",
    "owner_team": "LIMO Ops",
    "version": "0.1.0",
    "systems": [
      "ODIN",
      "Derivator MDM",
      "Product RT",
      "AURUM Final Eligibility",
      "DEW Store API",
      "Eligibility Consolidated Store API"
    ],
    "tags": ["limo", "1p", "store", "eligibility", "validation"]
  },
  "intake": {
    "required_inputs": ["offer_id", "store_id"]
  },
  "diagnostics": [
    {
      "id": "DIAG-ODIN-01",
      "purpose": "Fetch ODIN offer header attributes needed by the SOP and sub-cases.",
      "inputs": ["offer_id"],
      "outputs": { "observation_codes": ["ODIN_OFFER_FOUND", "ODIN_NOT_FOUND"] },
      "extract_fields": [
        "offer_id", "seller_id", "seller_type", "offer_created", "offer_type",
        "ftc", "item_class_id", "product_id", "delivery_method",
        "single_pillable", "approved_for_animals", "product_type",
        "acc_d_nbr", "pfhbrc", "vision_center_approved",
        "bundle_grp_type", "bundle_grp_sub_type"
      ]
    },
    {
      "id": "DIAG-MDM-STORE-01",
      "purpose": "Fetch store status from Derivator MDM stores-check endpoint.",
      "inputs": ["store_id"],
      "outputs": { "observation_codes": ["STORE_STATUS_PRESENT", "STORE_NOT_FOUND"] }
    },
    {
      "id": "DIAG-PRODUCT-RT-01",
      "purpose": "Fetch productAttributes (item_class_id, delivery_method, personalizable, personalization_url) from Product RT.",
      "inputs": ["product_id"],
      "outputs": { "observation_codes": ["PRODUCT_RT_PRESENT", "PRODUCT_RT_MISSING"] },
      "applies_to": ["tire", "photo"]
    },
    {
      "id": "DIAG-DISPATCH-SUBCASE",
      "purpose": "Classify the SOP sub-case (tire / photo / petrx / vision_rx / custom_cake / humax_rx / delivery_inhome / drone / ip_path / main).",
      "inputs": ["odin_attributes", "product_rt_attributes", "store_id"],
      "outputs": {
        "observation_codes": [
          "SUBCASE_TIRE", "SUBCASE_PHOTO", "SUBCASE_PETRX",
          "SUBCASE_VISION_RX", "SUBCASE_CUSTOM_CAKE",
          "SUBCASE_HUMAX_RX", "SUBCASE_DELIVERY_INHOME",
          "SUBCASE_DRONE", "SUBCASE_IP_PATH", "SUBCASE_MAIN"
        ]
      }
    },
    {
      "id": "DIAG-CHECK-STORE-LIST",
      "purpose": "O(1) membership check against the named eligible-store list.",
      "inputs": ["store_id", "list_name"],
      "outputs": { "observation_codes": ["STORE_ELIGIBLE", "STORE_NOT_ELIGIBLE", "BAD_REQUEST"] }
    },
    {
      "id": "DIAG-AURUM-01",
      "purpose": "Call AURUM Final Eligibility with offer_id + store_id; raw response.",
      "inputs": ["offer_id", "store_id"],
      "outputs": { "observation_codes": ["AURUM_RESPONSE_RECEIVED"] }
    },
    {
      "id": "DIAG-DEW-STORE-01",
      "purpose": "Call DEW Store API with offer_id + store_id; raw response.",
      "inputs": ["offer_id", "store_id"],
      "outputs": { "observation_codes": ["DEW_RESPONSE_RECEIVED"] }
    },
    {
      "id": "DIAG-CONSOLIDATED-STORE-01",
      "purpose": "Call Eligibility Consolidated Store with offer_id + store_id + partner_id + partner_type; raw response.",
      "inputs": ["offer_id", "store_id", "partner_id", "partner_type"],
      "outputs": { "observation_codes": ["CONSOLIDATED_RESPONSE_RECEIVED"] }
    },
    {
      "id": "DIAG-ANALYZE-AURUM",
      "purpose": "Project AURUM inclusions/exclusions for the canonical 30-path allow-list.",
      "inputs": ["aurum_response", "store_id"],
      "outputs": { "observation_codes": ["AURUM_PATHS_PRESENT", "AURUM_NO_PATHS", "AURUM_NOT_FOUND"] }
    },
    {
      "id": "DIAG-ANALYZE-DEW",
      "purpose": "Flatten ftxn.outboundPaths into [{path, methods, types}] rows.",
      "inputs": ["dew_response"],
      "outputs": { "observation_codes": ["DEW_PATHS_PRESENT", "DEW_NO_PATHS"] }
    },
    {
      "id": "DIAG-ANALYZE-CONSOLIDATED",
      "purpose": "Walk consolidatedResponse[].offerNodePayload.nodeData.STORE applying eligible/nodes/nodeExceptions semantics.",
      "inputs": ["consolidated_response", "store_id"],
      "outputs": { "observation_codes": ["CONSOLIDATED_PATHS_PRESENT", "CONSOLIDATED_NO_PATHS"] }
    }
  ],
  "decision_rules": [
    {
      "when": { "all": ["ODIN_NOT_FOUND"], "any": [], "expressions": [] },
      "then_runbook": "RBK-PATH-ODIN-NOT-FOUND"
    },
    {
      "when": { "all": [], "any": [], "expressions": ["state.offer_created == false"] },
      "then_runbook": "RBK-PATH-OFFER-NOT-CREATED"
    },
    {
      "when": { "all": [], "any": [], "expressions": ["state.store_status != 'OPEN'"] },
      "then_runbook": "RBK-PATH-STORE-NOT-OPEN"
    },
    {
      "when": { "all": [], "any": [], "expressions": ["state.subcase == 'tire' && state.store_list_eligible == false"] },
      "then_runbook": "RBK-PATH-TIRE-STORE-NOT-ELIGIBLE"
    },
    {
      "when": { "all": [], "any": [], "expressions": ["state.subcase == 'photo' && state.store_list_eligible == false"] },
      "then_runbook": "RBK-PATH-PHOTO-STORE-NOT-ELIGIBLE"
    },
    {
      "when": { "all": [], "any": [], "expressions": ["state.subcase == 'custom_cake' && state.store_list_eligible == false"] },
      "then_runbook": "RBK-PATH-CUSTOM-CAKE-STORE-NOT-ELIGIBLE"
    },
    {
      "when": { "all": [], "any": [], "expressions": ["state.subcase == 'drone' && state.store_list_eligible == false"] },
      "then_runbook": "RBK-PATH-DRONE-STORE-NOT-ELIGIBLE"
    },
    {
      "when": { "all": [], "any": [], "expressions": ["state.subcase == 'ip_path' && state.store_list_eligible == false"] },
      "then_runbook": "RBK-PATH-IP-STORE-NOT-ELIGIBLE"
    },
    {
      "when": { "all": [], "any": [], "expressions": ["state.subcase == 'delivery_inhome' && state.store_list_eligible == false"] },
      "then_runbook": "RBK-PATH-DELIVERY-INHOME-STORE-NOT-ELIGIBLE"
    },
    {
      "when": { "all": ["AURUM_PATHS_PRESENT", "DEW_PATHS_PRESENT", "CONSOLIDATED_PATHS_PRESENT"], "any": [], "expressions": [] },
      "then_runbook": "RBK-PATH-ELIGIBLE"
    },
    {
      "when": { "all": ["AURUM_PATHS_PRESENT"], "any": ["DEW_NO_PATHS", "CONSOLIDATED_NO_PATHS"], "expressions": [] },
      "then_runbook": "RBK-PATH-PARTIAL"
    },
    {
      "when": { "all": ["AURUM_NO_PATHS"], "any": [], "expressions": [] },
      "then_runbook": "RBK-PATH-NOT-ELIGIBLE"
    },
    {
      "when": { "all": ["AURUM_NOT_FOUND"], "any": [], "expressions": [] },
      "then_runbook": "RBK-PATH-AURUM-NODE-MISSING"
    }
  ],
  "runbooks": [
    {
      "id": "RBK-PATH-ELIGIBLE",
      "card_id": "P1",
      "name": "Offer + store path eligible",
      "description": "AURUM, DEW, and Consolidated Store all return at least one allowed path.",
      "tags": { "issue_tag": "NONE", "fix_tag": "NONE" },
      "actions": []
    },
    {
      "id": "RBK-PATH-PARTIAL",
      "card_id": "P2",
      "name": "Partial eligibility — downstream gap",
      "description": "AURUM has paths but a downstream system (DEW or Consolidated) does not.",
      "tags": { "issue_tag": "DOWNSTREAM_GAP", "fix_tag": "INVESTIGATE_LIMO_OPS" },
      "actions": []
    },
    {
      "id": "RBK-PATH-NOT-ELIGIBLE",
      "card_id": "N1",
      "name": "No eligibility paths from AURUM",
      "description": "AURUM returned no inclusion or exclusion paths for the canonical path list.",
      "tags": { "issue_tag": "AURUM_NO_PATHS", "fix_tag": "ESCALATE_LIMO_OPS" },
      "actions": []
    },
    {
      "id": "RBK-PATH-AURUM-NODE-MISSING",
      "card_id": "N2",
      "name": "Store missing in AURUM node map",
      "description": "AURUM offerNodeAttr.nodes does not contain the requested store id.",
      "tags": { "issue_tag": "AURUM_NODE_MISSING", "fix_tag": "ESCALATE_LIMO_OPS" },
      "actions": []
    },
    {
      "id": "RBK-PATH-ODIN-NOT-FOUND",
      "card_id": "B1",
      "name": "Offer not found in ODIN",
      "description": "Offer ID does not resolve in ODIN.",
      "tags": { "issue_tag": "ODIN_NOT_FOUND", "fix_tag": "VERIFY_OR_ESCALATE" },
      "actions": []
    },
    {
      "id": "RBK-PATH-OFFER-NOT-CREATED",
      "card_id": "B2",
      "name": "ODIN offer not fully created",
      "description": "Offer is in ODIN but oa.ofrCrt is not true.",
      "tags": { "issue_tag": "OFFER_NOT_CREATED", "fix_tag": "ESCALATE_LIMO_OPS" },
      "actions": []
    },
    {
      "id": "RBK-PATH-STORE-NOT-OPEN",
      "card_id": "B3",
      "name": "Store not OPEN",
      "description": "Derivator MDM reports the store status is not OPEN — LIMO cannot derive eligibility.",
      "tags": { "issue_tag": "STORE_NOT_OPEN", "fix_tag": "ESCALATE_LIMO_OPS" },
      "actions": []
    },
    {
      "id": "RBK-PATH-TIRE-STORE-NOT-ELIGIBLE",
      "card_id": "B4",
      "name": "Tire offer at a non-Tire-eligible store",
      "description": "Offer classifies as TIRE but the store is not in the Tire eligible list.",
      "tags": { "issue_tag": "STORE_NOT_ELIGIBLE", "fix_tag": "ESCALATE_LIMO_OPS" },
      "actions": []
    },
    {
      "id": "RBK-PATH-PHOTO-STORE-NOT-ELIGIBLE",
      "card_id": "B5",
      "name": "Photo offer at a non-Photo-eligible store",
      "description": "Offer classifies as PHOTOS but the store is not in the Photo eligible list.",
      "tags": { "issue_tag": "STORE_NOT_ELIGIBLE", "fix_tag": "ESCALATE_LIMO_OPS" },
      "actions": []
    },
    {
      "id": "RBK-PATH-CUSTOM-CAKE-STORE-NOT-ELIGIBLE",
      "card_id": "B6",
      "name": "Custom Cake offer at a non-Custom-Cake-eligible store",
      "description": "Offer matches Custom Cake hierarchy but the store is not in the Custom Cake list.",
      "tags": { "issue_tag": "STORE_NOT_ELIGIBLE", "fix_tag": "ESCALATE_LIMO_OPS" },
      "actions": []
    },
    {
      "id": "RBK-PATH-DRONE-STORE-NOT-ELIGIBLE",
      "card_id": "B7",
      "name": "Drone subcase but store not on drone list",
      "description": "Drone subcase requires a drone-eligible store.",
      "tags": { "issue_tag": "STORE_NOT_ELIGIBLE", "fix_tag": "ESCALATE_LIMO_OPS" },
      "actions": []
    },
    {
      "id": "RBK-PATH-IP-STORE-NOT-ELIGIBLE",
      "card_id": "B8",
      "name": "IP Path offer at a non-IP-eligible store",
      "description": "Online-only internal offer but store is not on the IP eligible list.",
      "tags": { "issue_tag": "STORE_NOT_ELIGIBLE", "fix_tag": "ESCALATE_LIMO_OPS" },
      "actions": []
    },
    {
      "id": "RBK-PATH-DELIVERY-INHOME-STORE-NOT-ELIGIBLE",
      "card_id": "B9",
      "name": "Delivery Inhome offer at a non-Inhome-eligible store",
      "description": "accDNbr=96 + allowed pfhbrc but the store is not on the Inhome list.",
      "tags": { "issue_tag": "STORE_NOT_ELIGIBLE", "fix_tag": "ESCALATE_LIMO_OPS" },
      "actions": []
    },
    {
      "id": "RBK-PATH-ESCALATE",
      "card_id": "E1",
      "name": "Escalate — fallback",
      "description": "No rule matched — manual investigation by LIMO Ops.",
      "tags": { "issue_tag": "UNCLASSIFIED", "fix_tag": "ESCALATE_LIMO_OPS" },
      "actions": []
    }
  ],
  "tools": [
    { "id": "DIAG-ODIN-01", "description": "Fetch offer from ODIN" },
    { "id": "DIAG-MDM-STORE-01", "description": "Fetch store status from Derivator MDM" },
    { "id": "DIAG-PRODUCT-RT-01", "description": "Fetch Product RT attributes" },
    { "id": "DIAG-DISPATCH-SUBCASE", "description": "Classify the SOP sub-case" },
    { "id": "DIAG-CHECK-STORE-LIST", "description": "Eligible-store list membership check" },
    { "id": "DIAG-AURUM-01", "description": "AURUM Final Eligibility API" },
    { "id": "DIAG-DEW-STORE-01", "description": "DEW Store API" },
    { "id": "DIAG-CONSOLIDATED-STORE-01", "description": "Eligibility Consolidated Store API" },
    { "id": "DIAG-ANALYZE-AURUM", "description": "AURUM path analyzer" },
    { "id": "DIAG-ANALYZE-DEW", "description": "DEW path analyzer" },
    { "id": "DIAG-ANALYZE-CONSOLIDATED", "description": "Consolidated path analyzer" },
    { "id": "DIAG-DECISION-MATRIX", "description": "Map observations to a 1P store-path runbook" }
  ],
  "guardrails": {
    "permitted_actions": [],
    "approvals": { "required_for_tools": [] },
    "blast_radius": { "max_batch_size": 1, "limits": {} }
  }
}
