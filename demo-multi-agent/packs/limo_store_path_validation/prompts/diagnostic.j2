  "offer_created": <true|false|null>,
  "store_status": "<OPEN|CLOSED|...|null>",
  "keyword_subcase": "<tire|photo|petrx|...|null>",
  "keyword_router_outcome": "<SUBCASE_TIRE|...|SUBCASE_NONE|SUBCASE_KEYWORD_CONFLICT|SUBCASE_RX_AMBIGUOUS|null>",
  "subcase": "<outbound_geo|tire|photo|...|main>",
