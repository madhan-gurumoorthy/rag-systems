{
  "metadata": {
    "title": "DevOps Health Check",
    "owner_team": "DevOps - Platform",
    "version": "0.1.0",
    "systems": ["Kubernetes", "Prometheus"],
    "tags": ["devops_health_check", "toy-pack"]
  },
  "intake": {
    "required_inputs": ["hostname", "service_name"]
  },
  "diagnostics": [
    {
      "id": "DIAG-PING-01",
      "purpose": "Check whether host responds to ping",
      "inputs": ["hostname"],
      "outputs": { "observation_codes": ["HOST_UP", "HOST_DOWN"] }
    },
    {
      "id": "DIAG-CPU-01",
      "purpose": "Check CPU utilisation against threshold",
      "inputs": ["hostname"],
      "outputs": { "observation_codes": ["CPU_OK", "CPU_HIGH"] }
    }
  ],
  "decision_rules": [
    {
      "when": { "all": ["HOST_DOWN"], "any": [], "expressions": [] },
      "then_runbook": "RUNBOOK-RESTART"
    },
    {
      "when": { "all": ["CPU_HIGH"], "any": [], "expressions": [] },
      "then_runbook": "RUNBOOK-RESTART"
    },
    {
      "when": { "all": ["HOST_UP", "CPU_OK"], "any": [], "expressions": [] },
      "then_runbook": "RUNBOOK-HEALTHY"
    }
  ],
  "runbooks": [
    {
      "id": "RUNBOOK-RESTART",
      "card_id": "R1",
      "name": "Restart unhealthy service",
      "description": "Service is unhealthy; restart and notify on-call.",
      "tags": { "issue_tag": "UNHEALTHY", "fix_tag": "RESTART" },
      "actions": [
        { "id": "notify", "description": "Notify on-call channel", "tool_id": "ACT-NOTIFY-01" },
        { "id": "restart", "description": "Restart the unhealthy service (requires approval)", "tool_id": "ACT-RESTART-01" }
      ]
    },
    {
      "id": "RUNBOOK-HEALTHY",
      "card_id": "H1",
      "name": "Healthy — no action",
      "description": "Host responds and CPU within threshold.",
      "tags": { "issue_tag": "FALSE_ALARM", "fix_tag": "NONE" },
      "actions": []
    }
  ],
  "tools": [
    { "id": "DIAG-PING-01", "description": "Ping host" },
    { "id": "DIAG-CPU-01", "description": "Check CPU utilisation" },
    { "id": "DIAG-DECISION-MATRIX", "description": "Map observations to runbook" },
    { "id": "ACT-NOTIFY-01", "description": "Notify on-call channel" },
    { "id": "ACT-RESTART-01", "description": "Restart a service on the target host (approval-gated)" }
  ],
  "guardrails": {
    "permitted_actions": ["restart", "notify"],
    "approvals": { "required_for_tools": ["ACT-RESTART-01"] },
    "blast_radius": { "max_batch_size": 1, "limits": { "max_restarts_per_hour": 10 } }
  }
}
