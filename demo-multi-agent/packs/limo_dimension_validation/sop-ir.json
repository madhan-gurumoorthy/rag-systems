{
  "metadata": {
    "title": "LIMO Dimension Validation",
    "owner_team": "LIMO Ops",
    "version": "0.3.0",
    "systems": ["ODIN", "IQS TI RT API", "Eligibility Consolidated API"],
    "tags": ["limo", "dimensions", "validation"]
  },
  "intake": {
    "required_inputs": ["offer_id"]
  },
  "diagnostics": [
    {
      "id": "DIAG-ODIN-01",
      "purpose": "Fetch offer header + product package dimensions from ODIN",
      "inputs": ["offer_id"],
      "outputs": { "observation_codes": ["ODIN_DIMS_PRESENT", "ODIN_DIMS_MISSING", "ODIN_NOT_FOUND"] },
      "extract_fields": ["offer_id", "seller_id", "seller_type", "wfs_eligible", "primary_gtin", "alternate_gtins", "odin_height", "odin_length", "odin_width", "odin_weight", "info_provider_code"]
    },
    {
      "id": "DIAG-IQS-TI-01",
      "purpose": "Fetch ALL trade-item records from IQS by GTIN (GOLD + Supplier). Agent classifies records by informationProviderTypeCode and extracts dimensions, lastUpdateTimestamp, and receivingDimensionsCaptureMethodTypeCode.",
      "inputs": ["gtin"],
      "outputs": {
        "observation_codes": ["TI_DATA_PRESENT", "TI_DIMS_MISSING"],
        "record_fields": [
          "informationProviderTypeCode",
          "tradeItemDimensionsHeightQty",
          "tradeItemDimensionsDepthQty",
          "tradeItemDimensionsWidthQty",
          "tradeItemWeightQty",
          "lastUpdateTimestamp",
          "receivingDimensionsCaptureMethodTypeCode"
        ]
      },
      "execution_coverage": "Primary GTIN + all Alternate GTINs"
    },
    {
      "id": "DIAG-CONSOLIDATED-01",
      "purpose": "Fetch downstream productPackageDimensions from Eligibility Consolidated API",
      "inputs": ["offer_id", "partner_id", "partner_type"],
      "outputs": { "observation_codes": ["CONSOLIDATED_DIMS_PRESENT", "CONSOLIDATED_DIMS_MISSING"] }
    },
    {
      "id": "DIAG-COMPARE-ODIN-IQS-01",
      "purpose": "Compare ODIN vs IQS TI dimensions (GOLD + Supplier) per dimension. Returns source selection explanation, timestamp-based reasoning, and capture method context.",
      "inputs": [
        "odin_height", "odin_length", "odin_width", "odin_weight",
        "iqs_gold_height", "iqs_gold_length", "iqs_gold_width", "iqs_gold_weight",
        "iqs_gold_timestamp", "iqs_gold_capture_method",
        "iqs_supplier_height", "iqs_supplier_length", "iqs_supplier_width", "iqs_supplier_weight",
        "iqs_supplier_timestamp"
      ],
      "outputs": {
        "observation_codes": [
          "ODIN_IQS_MATCH",
          "ODIN_IQS_MISMATCH",
          "ODIN_MISSING_IQS_PRESENT",
          "ODIN_PRESENT_IQS_MISSING",
          "BOTH_MISSING"
        ],
        "explanation_fields": [
          "selection_explanation",
          "iqs_gold_capture_method",
          "iqs_gold_timestamp",
          "iqs_supplier_timestamp"
        ]
      }
    },
    {
      "id": "DIAG-COMPARE-THREE-WAY-01",
      "purpose": "Compare ODIN / IQS / Consolidated dimensions (all values include UOM: IN for length/height/width, LB for weight)",
      "inputs": [
        "odin_height", "odin_length", "odin_width", "odin_weight",
        "iqs_height", "iqs_length", "iqs_width", "iqs_weight",
        "consolidated_height", "consolidated_length", "consolidated_width", "consolidated_weight"
      ],
      "outputs": { "observation_codes": ["ALL_MATCH", "CONSOLIDATED_MISMATCH", "CONSOLIDATED_MISSING"] }
    },
    {
      "id": "DIAG-COMPARE-MP-WEIGHT-01",
      "purpose": "Compare ODIN weight vs Consolidated weight for Marketplace (MP) offers (wfsElig=FALSE, seller_type=EXTERNAL). IQS TI is skipped; only weight is validated.",
      "inputs": ["odin_weight", "consolidated_weight"],
      "outputs": { "observation_codes": ["MP_WEIGHT_MATCH", "MP_WEIGHT_MISMATCH"] },
      "condition": "wfsElig=FALSE AND seller_type=EXTERNAL"
    }
  ],
  "decision_rules": [
    {
      "when": { "all": ["ODIN_NOT_FOUND"], "any": [], "expressions": [] },
      "then_runbook": "RBK-LIMO-ODIN-NOT-FOUND"
    },
    {
      "when": { "all": ["MP_WEIGHT_MATCH"], "any": [], "expressions": [] },
      "then_runbook": "RBK-LIMO-MP-PASS"
    },
    {
      "when": { "all": ["MP_WEIGHT_MISMATCH"], "any": [], "expressions": [] },
      "then_runbook": "RBK-LIMO-MP-FAIL"
    },
    {
      "when": { "all": ["ODIN_IQS_MATCH", "ALL_MATCH"], "any": [], "expressions": [] },
      "then_runbook": "RBK-LIMO-PASS"
    },
    {
      "when": { "all": ["ODIN_IQS_MATCH", "CONSOLIDATED_MISMATCH"], "any": [], "expressions": [] },
      "then_runbook": "RBK-LIMO-FAIL-CONS"
    },
    {
      "when": { "all": ["ODIN_IQS_MISMATCH"], "any": [], "expressions": [] },
      "then_runbook": "RBK-LIMO-FAIL-ODIN-IQS"
    },
    {
      "when": { "all": ["ODIN_MISSING_IQS_PRESENT"], "any": [], "expressions": [] },
      "then_runbook": "RBK-LIMO-INV-ODIN-MISSING"
    },
    {
      "when": { "all": ["ODIN_PRESENT_IQS_MISSING"], "any": [], "expressions": [] },
      "then_runbook": "RBK-LIMO-INV-IQS-MISSING"
    },
    {
      "when": { "all": ["BOTH_MISSING"], "any": [], "expressions": [] },
      "then_runbook": "RBK-LIMO-BLOCKED-BOTH"
    }
  ],
  "runbooks": [
    {
      "id": "RBK-LIMO-ODIN-NOT-FOUND",
      "card_id": "N1",
      "name": "Offer not found in ODIN",
      "description": "The Offer ID was not found in ODIN. Validates the ID format (32-char hex) and advises the user accordingly — retry with correct ID or escalate to LIMO Ops.",
      "tags": { "issue_tag": "ODIN_NOT_FOUND", "fix_tag": "VERIFY_OR_ESCALATE" },
      "actions": []
    },
    {
      "id": "RBK-LIMO-PASS",
      "card_id": "P1",
      "name": "All three systems in sync",
      "description": "ODIN, IQS TI, and Consolidated API dimensions all match.",
      "tags": { "issue_tag": "NONE", "fix_tag": "NONE" },
      "actions": []
    },
    {
      "id": "RBK-LIMO-FAIL-CONS",
      "card_id": "F2",
      "name": "Consolidated API mismatch",
      "description": "ODIN and IQS match but Consolidated API differs — route to LIMO Ops.",
      "tags": { "issue_tag": "CONSOLIDATED_MISMATCH", "fix_tag": "ESCALATE_LIMO_OPS" },
      "actions": []
    },
    {
      "id": "RBK-LIMO-FAIL-ODIN-IQS",
      "card_id": "F1",
      "name": "ODIN vs IQS mismatch",
      "description": "ODIN and IQS TI dimensions disagree — route to LIMO Ops.",
      "tags": { "issue_tag": "ODIN_IQS_MISMATCH", "fix_tag": "ESCALATE_LIMO_OPS" },
      "actions": []
    },
    {
      "id": "RBK-LIMO-INV-ODIN-MISSING",
      "card_id": "I1",
      "name": "ODIN dimensions missing",
      "description": "ODIN missing dimensions while IQS has them — investigate.",
      "tags": { "issue_tag": "ODIN_MISSING", "fix_tag": "INVESTIGATE_LIMO_OPS" },
      "actions": []
    },
    {
      "id": "RBK-LIMO-INV-IQS-MISSING",
      "card_id": "I2",
      "name": "IQS dimensions missing",
      "description": "IQS missing or partial while ODIN has dimensions — investigate.",
      "tags": { "issue_tag": "IQS_MISSING", "fix_tag": "INVESTIGATE_LIMO_OPS" },
      "actions": []
    },
    {
      "id": "RBK-LIMO-BLOCKED-BOTH",
      "card_id": "B1",
      "name": "ODIN and IQS both missing",
      "description": "No dimensions in either source — manual investigation required.",
      "tags": { "issue_tag": "BOTH_MISSING", "fix_tag": "INVESTIGATE_LIMO_OPS" },
      "actions": []
    },
    {
      "id": "RBK-LIMO-MP-PASS",
      "card_id": "MP1",
      "name": "MP offer — weight matches",
      "description": "Marketplace offer (wfsElig=FALSE, seller_type=EXTERNAL): ODIN weight matches Consolidated API weight. IQS TI skipped.",
      "tags": { "issue_tag": "NONE", "fix_tag": "NONE" },
      "actions": []
    },
    {
      "id": "RBK-LIMO-MP-FAIL",
      "card_id": "MP2",
      "name": "MP offer — weight mismatch",
      "description": "Marketplace offer (wfsElig=FALSE, seller_type=EXTERNAL): ODIN weight does not match Consolidated API weight. Route to LIMO Ops.",
      "tags": { "issue_tag": "MP_WEIGHT_MISMATCH", "fix_tag": "ESCALATE_LIMO_OPS" },
      "actions": []
    }
  ],
  "tools": [
    { "id": "DIAG-ODIN-01", "description": "Fetch offer from ODIN" },
    { "id": "DIAG-IQS-TI-01", "description": "Fetch ALL trade-item records from IQS (GOLD + Supplier)" },
    { "id": "DIAG-CONSOLIDATED-01", "description": "Fetch downstream Consolidated dimensions" },
    { "id": "DIAG-COMPARE-ODIN-IQS-01", "description": "Compare ODIN vs IQS dimensions with source selection explanation" },
    { "id": "DIAG-COMPARE-THREE-WAY-01", "description": "Compare ODIN / IQS / Consolidated dimensions" },
    { "id": "DIAG-COMPARE-MP-WEIGHT-01", "description": "Compare ODIN weight vs Consolidated weight (MP offers only)" },
    { "id": "DIAG-DECISION-MATRIX", "description": "Map observations to a LIMO runbook" }
  ],
  "guardrails": {
    "permitted_actions": [],
    "approvals": { "required_for_tools": [] },
    "blast_radius": { "max_batch_size": 1, "limits": {} }
  }
}
