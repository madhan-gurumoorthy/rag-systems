{
  "metadata": {
    "title": "Wakanda Inventory SOP Agent — Query Runbook Catalogue",
    "owner_team": "ItemOps - Wakanda Platform",
    "version": "1.0.0",
    "systems": [
      "Oasis API",
      "BigQuery (killmonger, mbaku, salescap, reservation tables)",
      "Google Cloud Storage (signed URLs)"
    ],
    "tags": [
      "Inventory",
      "OOS",
      "Transactability",
      "Salescap",
      "Reservations",
      "Event Inventory",
      "Order Status",
      "Node Health",
      "Offer ID",
      "Preorder",
      "Release Date"
    ]
  },
  "intake": {
    "required_inputs": ["offer_id"],
    "optional_inputs": ["node_id", "order_id", "event_id", "event_type", "start_time", "end_time", "days", "start_date", "end_date", "query_type", "filter_sections"]
  },
  "sops": [
    {
      "id": "oos_node_diagnosis",
      "description": "Out-of-Stock / Transactability Diagnosis at Node Level",
      "trigger_keywords": [
        "out of stock at", "oos at", "not transactable at", "not available at",
        "why is offer", "why is item", "transactability issue", "offer not available",
        "why offer", "transact", "lock", "locks",
        "active lock", "eligibility", "eligible", "accmodes", "node eligibility"
      ],
      "required_params": ["offer_id", "node_id"],
      "node_scope": true,
      "steps": [
        {
          "tool_id": "DIAG-GLI-01",
          "description": "Check Oasis API Customer GLI (national inventory context)",
          "required_params": ["offer_id"],
          "skip_on_failure": true
        },
        {
          "tool_id": "DIAG-NODE-01",
          "description": "Check BigQuery node snapshot (killmonger + mbaku)",
          "required_params": ["offer_id", "node_id"],
          "skip_on_failure": false
        },
        {
          "tool_id": "DIAG-TRANS-01",
          "description": "Run node-level transactability diagnosis",
          "required_params": ["offer_id", "node_id"],
          "skip_on_failure": false
        },
        {
          "tool_id": "DIAG-CAP-01",
          "description": "Check active salescaps restricting availability",
          "required_params": ["offer_id"],
          "skip_on_failure": true
        },
        {
          "tool_id": "DIAG-OFFRES-01",
          "description": "Check offer-level backorders and reservations",
          "required_params": ["offer_id"],
          "skip_on_failure": true
        }
      ]
    },
    {
      "id": "oos_national_diagnosis",
      "description": "Out-of-Stock / Transactability Diagnosis at National Level",
      "trigger_keywords": [
        "out of stock nationally", "oos national", "not transactable nationally",
        "national level", "not available nationally", "global oos",
        "why is offer nationally"
      ],
      "required_params": ["offer_id"],
      "node_scope": false,
      "steps": [
        {
          "tool_id": "DIAG-GLI-01",
          "description": "Check Oasis API Customer GLI (national inventory)",
          "required_params": ["offer_id"],
          "skip_on_failure": false
        },
        {
          "tool_id": "DIAG-TRANS-NAT-01",
          "description": "Run national transactability diagnosis",
          "required_params": ["offer_id"],
          "skip_on_failure": false
        },
        {
          "tool_id": "DIAG-CAP-01",
          "description": "Check active salescaps restricting national availability",
          "required_params": ["offer_id"],
          "skip_on_failure": true
        },
        {
          "tool_id": "DIAG-OFFRES-01",
          "description": "Check offer-level backorders and reservations",
          "required_params": ["offer_id"],
          "skip_on_failure": true
        }
      ]
    },
    {
