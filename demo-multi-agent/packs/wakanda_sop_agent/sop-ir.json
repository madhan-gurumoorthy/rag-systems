      "required_params": ["offer_id"],
      "node_scope": null,
      "steps": [
        {
          "tool_id": "DIAG-EVENT-01",
          "description": "Run event inventory validation and generate per-offer CSV report",
          "required_params": ["offer_ids"],
          "skip_on_failure": false
        }
      ]
    },
