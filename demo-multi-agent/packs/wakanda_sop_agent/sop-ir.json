          "required_params": ["offer_id"],
          "skip_on_failure": true
        },
        {
          "tool_id": "DIAG-TRANS-NAT-01",
          "description": "Run national transactability diagnosis",
          "required_params": ["offer_id"],
          "skip_on_failure": true
