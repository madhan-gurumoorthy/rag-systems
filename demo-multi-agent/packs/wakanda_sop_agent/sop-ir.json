      "required_params": ["offer_id", "node_id", "order_id"],
      "node_scope": null,
      "steps": [
        {
          "tool_id": "DIAG-GLI-01",
          "description": "Level 1: Check national (offer-level) inventory context",
          "required_params": ["offer_id"],
          "skip_on_failure": true
        },
        {
          "tool_id": "DIAG-NODE-01",
          "description": "Level 2: Check node-level inventory snapshot",
