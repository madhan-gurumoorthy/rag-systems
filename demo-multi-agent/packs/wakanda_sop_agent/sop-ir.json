  "runbooks": [
    {
      "id": "RBK-WAK-01",
      "verdict": "FITS_QUERY",
      "description": "Query answered successfully — return tool data to user"
    },
    {
      "id": "RBK-WAK-02",
      "verdict": "INSUFFICIENT_DATA",
      "description": "All tools returned no data for the given offer_id / node_id"
    },
    {
      "id": "RBK-WAK-03",
      "verdict": "ESCALATE",
      "description": "Required parameters missing, auth failure, or unhandled API error"
    }
  ]
