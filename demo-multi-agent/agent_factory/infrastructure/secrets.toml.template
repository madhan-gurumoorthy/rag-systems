# ══════════════════════════════════════════════════════════════════════
# Agent Factory — Secrets Configuration Template
# ══════════════════════════════════════════════════════════════════════
# The framework reads secrets from TWO files:
#
#   1. agent_factory/infrastructure/secrets.toml — Common, framework-
#      owned credentials (Akeyless-synced via run_dev.sh).
#   2. packs/<pack_id>/secrets.toml — Per-pack credentials. Loaded by
#      pack_loader.py at pack-activation time and merged into the same
#      Dynaconf config object.
#
# Both files use the same flat [default.<section>] shape and are
# accessed identically: config.<section>.<key>.
#
# Copy this template into either location and fill in the values that
# belong there. Both files are gitignored — NEVER commit real
# credentials.
# ══════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# Section 1 — Common (framework) secrets
#
# These belong in: agent_factory/infrastructure/secrets.toml
# ──────────────────────────────────────────────────────────────────────

[default]
# ── Agent Identity ───────────────────────────────────────────────────
AGENT_NAME = "my-agent"
APP_TITLE = "My Agent"
APP_DESCRIPTION = "Config-driven agent built with the Agent Factory"

# ── Azure OpenAI (LLM Provider) ─────────────────────────────────────
[default.azure_chat]
LIGHTRAG_MODEL = "gpt-4o"
LIGHTRAG_API_VERSION = "2024-06-01"
LIGHTRAG_AZURE_ENDPOINT = "https://your-resource.openai.azure.com/"
# Auth headers are handled by SOA or set below:
# LIGHTRAG_API_KEY = "your-api-key"

# ── PostgreSQL (canonical 4-table persistence layer) ────────────────
[default.postgresql]
LIGHTRAG_POSTGRES_HOST = "your-postgres-host.walmart.com"
LIGHTRAG_POSTGRES_PORT = "5432"
LIGHTRAG_POSTGRES_DATABASE = "matbot"
LIGHTRAG_POSTGRES_USER = "agent_user"
LIGHTRAG_POSTGRES_PASSWORD = "vault://path/to/db-password"

# ── MatBot Common Services (Slack + email gateway) ──────────────────
[default.matbot_services]
URL = ""
TIMEOUT_SECONDS = 30

# ── Work-item response budget ───────────────────────────────────────
[default.work_item_runtime]
RESPONSE_BUDGET_SECONDS = 180

# ── CORS (browser cross-origin policy) ──────────────────────────────
# Controls which origins the React dashboard (and any other browser
# client) may call into. ALLOW_ORIGINS pins exact origins;
# ALLOW_ORIGIN_REGEX matches any origin that satisfies the pattern
# (the example below covers every *.walmart.com subdomain across
# environments without enumerating them). An origin is allowed if it
# matches EITHER list. The CORS middleware is only mounted when at
# least one of the two is configured; omit the block entirely for a
# server-to-server-only deployment. Never combine "*" with
# ALLOW_CREDENTIALS = true — browsers reject the combination.
[default.cors]
ALLOW_ORIGINS      = ["http://localhost:5173", "http://localhost:3000"]
ALLOW_ORIGIN_REGEX = "https?://([a-zA-Z0-9-]+\\.)*walmart\\.com(:[0-9]+)?"
ALLOW_CREDENTIALS  = true
ALLOW_METHODS      = ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
ALLOW_HEADERS      = ["*"]
EXPOSE_HEADERS     = []
MAX_AGE_SECONDS    = 600

# ── Concord (approval workflow) ─────────────────────────────────────
[default.concord]
CONCORD_BASE_URL = "https://concord.prod.walmart.com"
CONCORD_API_TOKEN = "vault://path/to/concord-token"
CONCORD_ORG = "your-org"
CONCORD_PROJECT = "agent-factory"

# ── Cron poller (drives /a2a/work-item/process loops) ───────────────
[default.cron_poller]
AGENT_BASE_URL = "http://localhost:8000"
POLL_INTERVAL_SECONDS = 300
MAX_INCIDENTS_PER_POLL = 50

# ──────────────────────────────────────────────────────────────────────
# Section 2 — Per-pack secrets
#
# These belong in: packs/<pack_id>/secrets.toml
#
# Add one [default.<section>] block per upstream system your pack
# tools.yaml references. Every {{KEY}} placeholder in url_template /
# headers / auth resolves against these sections.
# ──────────────────────────────────────────────────────────────────────

# Example pack-scoped sections (uncomment in your pack's secrets.toml):

# [default.my_api]
# API_BASE_URL = "https://api.example.walmart.com"
# API_AUTH_TOKEN = "vault://path/to/token"

# [default.jira]
# base_url = "https://jira.walmart.com"
# username = "your-service-account"
# api_token = "vault://path/to/jira-token"

# [default.kafka]
# bootstrap_servers = "kafka-broker1:9092,kafka-broker2:9092"
# security_protocol = "SSL"
# ssl_cafile = "/path/to/ca.pem"
# ssl_certfile = "/path/to/cert.pem"
# ssl_keyfile = "/path/to/key.pem"

# [default.elasticsearch]
# url = "https://elasticsearch.walmart.com:9200"
# username = "elastic"
# password = "vault://path/to/es-password"

# [default.redis]
# host = "redis.walmart.com"
