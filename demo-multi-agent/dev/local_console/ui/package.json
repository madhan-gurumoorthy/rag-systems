    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/dompurify": "3.0.5",
    "@types/node": "20.16.11",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  },
  "overrides": {
    "@babel/helper-validator-identifier": "7.28.5"
